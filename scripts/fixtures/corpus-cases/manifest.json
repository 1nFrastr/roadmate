{
  "schema": "roadmate-timeline-eval/1",
  "cases": [
    {
      "id": "multi-theme-user",
      "description": "Real-user style posts + cross-theme mix (16 posts); keep concrete multi-theme tags, filter career noise",
      "postsFile": "multi-theme-user.posts.txt",
      "expect": {
        "anyOf": [
          ["Xiamen", "hostel", "solo travel"],
          ["pour-over", "Yirgacheffe", "coffee"],
          ["Frieren", "Hollow Knight"],
          ["climbing", "gym", "V4"],
          ["TOEFL", "grad exam", "study room"],
          ["Chaoshan", "hotpot"],
          ["Western Sichuan", "cycling"],
          ["film", "Kodak"]
        ],
        "forbidden": ["salary", "dating", "impostor", "mindset", "interview", "job hunt"],
        "minTags": 5,
        "maxTags": 12,
        "minSignalPosts": 6
      }
    },
    {
      "id": "hobby-dense",
      "description": "Four themes dense (coffee/climbing/gaming/film ×4 each, 16 posts) — test four lines coexisting",
      "postsFile": "hobby-dense.posts.txt",
      "expect": {
        "anyOf": [
          ["pour-over", "coffee", "Chaoshan", "latte"],
          ["climbing", "gym", "hangboard", "Baihe"],
          ["Frieren", "Hollow Knight", "Helldivers", "indie"],
          ["film", "Kodak", "street", "medium format"]
        ],
        "forbidden": ["food", "sports", "games", "photography"],
        "minTags": 6,
        "maxTags": 12,
        "minSignalPosts": 12
      }
    },
    {
      "id": "noise-mixed",
      "description": "Mostly career/mindset noise (16 posts); sparse interest signals should survive denoise",
      "postsFile": "noise-mixed.posts.txt",
      "expect": {
        "anyOf": [
          ["Xiamen", "hostel"],
          ["pour-over", "coffee"],
          ["Hollow Knight", "Switch"],
          ["Frieren"],
          ["climbing", "gym"],
          ["Western Sichuan", "cycling"],
          ["TOEFL", "grad exam", "study room"]
        ],
        "forbidden": ["salary", "dating", "impostor", "mindset", "interview", "PUA", "lie flat"],
        "minTags": 3,
        "maxTags": 10,
        "minSignalPosts": 4
      }
    },
    {
      "id": "sparse-noise",
      "description": "No clear interest signal (8 posts); few tags or empty",
      "postsFile": "sparse-noise.posts.txt",
      "expect": {
        "forbidden": ["weather", "overtime", "subway"],
        "minTags": 0,
        "maxTags": 2,
        "minSignalPosts": 0
      }
    },
    {
      "id": "burst-merge-coffee",
      "description": "4 coffee-only posts within 5 days — after in-window merge, frequency entries ≥3",
      "postsFile": "burst-merge-coffee.posts.txt",
      "expect": {
        "anyOf": [
          ["pour-over", "Yirgacheffe", "coffee"],
          ["espresso", "grinder", "shot"],
          ["latte", "dirty"]
        ],
        "forbidden": ["food", "drinks"],
        "minTags": 1,
        "maxTags": 5,
        "minSignalPosts": 4
      }
    },
    {
      "id": "cross-period-coffee",
      "description": "Coffee across @1d/@1m/@3m waves with career noise — no cross-period merge; cross-period frequency still accumulates",
      "postsFile": "cross-period-coffee.posts.txt",
      "expect": {
        "anyOf": [
          ["pour-over", "Yirgacheffe", "coffee"],
          ["latte art", "latte"],
          ["cafe", "cafe hopping"]
        ],
        "forbidden": ["salary", "PUA", "interview", "mindset"],
        "minTags": 1,
        "maxTags": 6,
        "minSignalPosts": 4
      }
    },
    {
      "id": "climbing-dominant",
      "description": "Climbing ×10 + noise ×2 — single-theme high frequency should dominate the tag list",
      "postsFile": "climbing-dominant.posts.txt",
      "expect": {
        "anyOf": [
          ["climbing", "gym", "V4"],
          ["hangboard", "hang"],
          ["Baihe", "crag", "lead"],
          ["bouldering", "send"]
        ],
        "forbidden": ["weather", "subway", "sports"],
        "minTags": 3,
        "maxTags": 8,
        "minSignalPosts": 8
      }
    },
    {
      "id": "two-theme-recency",
      "description": "Recent coffee ×3 vs older cycling ×1 — coffee weight should beat cycling",
      "postsFile": "two-theme-recency.posts.txt",
      "expect": {
        "anyOf": [
          ["pour-over", "Yirgacheffe", "coffee", "latte", "grinder"],
          ["Western Sichuan", "cycling", "loop"]
        ],
        "forbidden": ["food", "travel", "sports"],
        "minTags": 2,
        "maxTags": 5,
        "minSignalPosts": 4
      }
    },
    {
      "id": "long-scattered",
      "description": "20-post long sparse multi-theme list — denoise + keep coexisting themes without dropping signal",
      "postsFile": "long-scattered.posts.txt",
      "expect": {
        "anyOf": [
          ["Xiamen", "hostel"],
          ["pour-over", "coffee", "Yirgacheffe"],
          ["Frieren"],
          ["climbing", "V4", "gym"],
          ["Hollow Knight", "Switch"],
          ["grad exam", "study room", "politics"],
          ["Western Sichuan", "cycling"],
          ["film", "Kodak"],
          ["Chaoshan", "hotpot"],
          ["TOEFL", "TPO"],
          ["Helldivers"]
        ],
        "forbidden": ["salary", "impostor", "mindset", "interview", "weather", "overtime"],
        "minTags": 5,
        "maxTags": 12,
        "minSignalPosts": 8
      }
    },
    {
      "id": "four-month-multi-theme",
      "description": "50 posts across ~4 months, mixed detail levels — long-horizon denoise, cross-period merge, multi-interest coexistence",
      "postsFile": "four-month-multi-theme.posts.txt",
      "expect": {
        "anyOf": [
          ["pour-over", "Yirgacheffe", "coffee", "espresso", "latte art"],
          ["climbing", "gym", "V4", "bouldering", "hangboard"],
          ["Frieren", "Hollow Knight", "Helldivers", "Balatro"],
          ["film", "Kodak", "Portra", "medium format", "street"],
          ["Xiamen", "hostel", "Western Sichuan", "cycling", "Chaoshan"],
          ["grad exam", "politics", "study room", "TOEFL", "TPO"]
        ],
        "forbidden": ["salary", "impostor", "mindset", "interview", "PUA", "lie flat", "weather", "overtime"],
        "minTags": 6,
        "maxTags": 15,
        "minSignalPosts": 25
      }
    }
  ]
}
